# vim: ft=sh
typeset -ga SECRET_COMMANDS=(
  'release-pull-request'
  'npm run release'
  'npm run quick-release'
)

typeset -g _secrets_armed=0

_needs_secrets() {
  local line=$1 pat
  line=${line#"${line%%[![:space:]]*}"}   # unchanged — works fine here
  for pat in $SECRET_COMMANDS; do
    [[ $line == $pat || $line == "$pat "* ]] && return 0
  done
  return 1
}

_secrets_preexec() {
  if _needs_secrets "$1"; then
    enable-secrets
    _secrets_armed=1
  fi
}

_secrets_precmd() {
  if (( _secrets_armed )); then
    disable-secrets
    _secrets_armed=0
  fi
}

autoload -Uz add-zsh-hook
add-zsh-hook preexec _secrets_preexec
add-zsh-hook precmd  _secrets_precmd
